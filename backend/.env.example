# DailyBuddy Backend Environment Configuration Template
# Copy to .env for local overrides or set in Render Environment Variables dashboard.
# NEVER commit actual secrets or production credentials to source control.

# Set to False in production
DJANGO_DEBUG=False

# Required in production: generate a strong 50+ character random string
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-character-secret-key

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=dailybuddy-api.onrender.com,localhost,127.0.0.1

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=https://dailybuddy.vercel.app

# Comma-separated list of trusted origins for CSRF & Django Admin
CSRF_TRUSTED_ORIGINS=https://dailybuddy.vercel.app,https://dailybuddy-api.onrender.com

# Database URL (Leave blank to use SQLite by default; populate with PostgreSQL connection string in production)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: Set to False if SSL termination is handled by an outer proxy without HTTPS forwarding
# SECURE_SSL_REDIRECT=True
