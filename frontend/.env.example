# DailyBuddy Frontend Environment Configuration Template
# Copy to .env for local overrides or set in Vercel Environment Variables dashboard.
# NEVER store secrets here; Vite environment variables are embedded in client bundles.

# URL of the backend API (leave blank in dev to use http://127.0.0.1:8000/api or Vite proxy)
VITE_API_URL=https://dailybuddy-api.onrender.com/api
